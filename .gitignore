# theaibucket site code — whitelist repository.
# Rooted at the WordPress site root (standard WP layout: wp-content/, not Bedrock).
# Everything is ignored by default; only the theme is tracked.

# 1. Ignore everything at the root...
/*
# ...except these.
!.gitignore
!README.md
!wp-content/

# 2. Inside wp-content/: ignore all, keep only themes/ scaffolding.
wp-content/*
!wp-content/themes/

# 3. Only the aibucket theme.
wp-content/themes/*
!wp-content/themes/aibucket-theme/

# 4. Build artefacts / vendored deps (the theme also carries its own nested
#    .gitignore; this is a backstop).
wp-content/themes/aibucket-theme/node_modules/
wp-content/themes/aibucket-theme/vendor/

# 5. OS / editor cruft anywhere.
.DS_Store
*.log
.wolf/
.claude/
.idea/
